{
  "name": "hop-on-travel-planner",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces",
    "lint": "oxlint . --deny-warnings --deny no-explicit-any --deny require-jsdoc",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.62.0",
    "prettier": "^3.8.3",
    "typescript": "^5.0.0",
    "vitest": "^1.6.1"
  }
}
